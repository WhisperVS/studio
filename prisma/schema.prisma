generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id                     String                @id
  machineName            String                @default("N/A")
  category               AssetCategory
  os                     String?
  location               Location
  manufacturer           String                @default("N/A")
  partNumber             String?
  modelNumber            String?
  serialNumber           String                @default("N/A")
  type                   String?
  webui                  String?
  assignedUser           String?
  userId                 String?
  userType               UserType?
  owner                  String                @default("Group Administrators")
  status                 AssetStatus
  notes                  String?
  purchaseDate           DateTime?
  warrantyExpirationDate DateTime?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

enum AssetCategory {
  laptops
  servers
  systems
  networks
  printers
  misc
}

enum Location {
  SchaumburgIL @map("Schaumburg IL")
  RockfordIL   @map("Rockford IL")
}

enum UserType {
  local
  remote
}

enum AssetStatus {
  InUse       @map("In Use")
  Spare       @map("Spare")
  ForRepair   @map("For Repair")
  ForParts    @map("For Parts")
  ForRecycle  @map("For Recycle")
}
